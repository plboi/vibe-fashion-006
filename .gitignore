# ==========================================
# Git 추적 제외 목록
# ==========================================

# 가상 환경 (Virtual Environments)
venv/
.venv/
env/
ENV/

# 파이썬 바이트코드 및 캐시 파일
__pycache__/
*.py[cod]
*$py.class
*.so

# 환경 변수 및 민감 정보 파일 (보안을 위해 반드시 제외)
.env
.env.local

# 배포 및 빌드 산출물
dist/
build/
*.egg-info/

# 데이터베이스 및 로컬 스토리지
*.db
*.sqlite3

# 로그 파일
*.log

# 에디터 및 운영체제 설정 파일
.vscode/
.idea/
.DS_Store
Thumbs.db

*.PYC